{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "认知契约目标 Schema",
  "description": "基于认知科学范式的目标跟踪结构定义",
  "type": "object",
  "required": ["cognitive_contract", "goals"],
  "properties": {
    "cognitive_contract": {
      "type": "object",
      "description": "认知契约元数据",
      "required": ["version", "agents_md_hash", "last_sync"],
      "properties": {
        "version": {
          "type": "string",
          "description": "认知契约版本号",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "agents_md_hash": {
          "type": "string",
          "description": "agents.md 的 SHA256 哈希值",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "last_sync": {
          "type": "string",
          "format": "date-time",
          "description": "最后同步时间"
        },
        "validation_status": {
          "type": "string",
          "enum": ["valid", "warning", "error"],
          "description": "校验状态"
        }
      }
    },
    "goals": {
      "type": "array",
      "description": "目标列表",
      "items": {
        "type": "object",
        "required": ["id", "title", "cognitive_layer", "status", "priority", "tasks"],
        "properties": {
          "id": {
            "type": "string",
            "description": "目标唯一标识"
          },
          "title": {
            "type": "string",
            "description": "目标标题"
          },
          "description": {
            "type": "string",
            "description": "目标详细描述"
          },
          "cognitive_layer": {
            "type": "string",
            "enum": ["价值层", "规则层", "结构层", "概念层", "感知层"],
            "description": "关联的认知层级"
          },
          "related_rules": {
            "type": "array",
            "items": { "type": "string" },
            "description": "关联的规则层约束"
          },
          "status": {
            "type": "string",
            "enum": ["active", "completed", "paused", "cancelled"],
            "description": "目标状态"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "优先级"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "进度百分比（自动计算）"
          },
          "created_at": {
            "type": "string",
            "format": "date",
            "description": "创建日期"
          },
          "updated_at": {
            "type": "string",
            "format": "date",
            "description": "更新日期"
          },
          "target_date": {
            "type": "string",
            "format": "date",
            "description": "目标完成日期"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "标签列表"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "status"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "任务唯一标识"
                },
                "title": {
                  "type": "string",
                  "description": "任务标题"
                },
                "status": {
                  "type": "string",
                  "enum": ["pending", "in_progress", "completed", "blocked"],
                  "description": "任务状态"
                },
                "related_files": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "相关文件列表"
                },
                "completed_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "完成时间"
                },
                "cognitive_validation": {
                  "type": "object",
                  "description": "认知校验信息",
                  "properties": {
                    "metacognition_check": {
                      "type": "boolean",
                      "description": "是否通过元认知自检"
                    },
                    "five_layer_coverage": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["价值层", "规则层", "结构层", "概念层", "感知层"]
                      },
                      "description": "覆盖的认知层"
                    },
                    "schema_alignment": {
                      "type": "string",
                      "enum": ["同化", "顺应"],
                      "description": "图式迭代类型"
                    }
                  }
                }
              }
            },
            "description": "子任务列表"
          },
          "knowledge_network": {
            "type": "object",
            "description": "知识三层网络关联",
            "properties": {
              "principle": {
                "type": "string",
                "description": "关联的核心原则"
              },
              "pattern": {
                "type": "string",
                "description": "关联的通用模式"
              },
              "instance": {
                "type": "string",
                "description": "关联的具体案例"
              }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "统计信息（自动计算）",
      "properties": {
        "total": { "type": "integer" },
        "active": { "type": "integer" },
        "completed": { "type": "integer" },
        "paused": { "type": "integer" },
        "overallProgress": { "type": "number" }
      }
    }
  }
}
