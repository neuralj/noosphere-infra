#!/bin/bash
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SUPERVISOR_CONF="$REPO_ROOT/supervisor/supervisord.conf"
export REPO_ROOT

ctl() {
    supervisorctl -c "$SUPERVISOR_CONF" "$@"
}

SERVICES=(caddy openlaputa-panel opensheeta-panel a-bulletin-panel)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

usage() {
    cat <<EOF
Usage: $0 <command> [service]

Commands:
  status              Show status of all services
  start [service]     Start service(s)
  stop [service]      Stop service(s)
  restart [service]   Restart service(s)
  logs [service]      Show logs (tail -f, default: supervisord)
  reload              Reread config & restart changed services
  build <target>      Build a service (e.g. viewer)

Services: ${SERVICES[*]}

Examples:
  $0 status
  $0 start
  $0 restart caddy
  $0 logs viewer
  $0 reload
  $0 build viewer
EOF
}

get_port() {
    local svc=$1
    case $svc in
        caddy) echo "443" ;;
        openlaputa-panel) echo "3000" ;;
        opensheeta-panel) echo "3099" ;;
        a-bulletin-panel) echo "3093" ;;
    esac
}

do_status() {
    printf "%-18s %-10s %-6s %-8s\n" "SERVICE" "STATUS" "PORT" "PID"
    printf "%-18s %-10s %-6s %-8s\n" "-------" "------" "----" "---"
    for svc in "${SERVICES[@]}"; do
        local port=$(get_port $svc)
        local line
        line=$(ctl status "$svc" 2>/dev/null || true)
        if echo "$line" | grep -q "RUNNING"; then
            local pid=$(echo "$line" | awk '{print $4}' | sed 's/,//')
            printf "%-18s ${GREEN}%-10s${NC} %-6s %-8s\n" "$svc" "running" "$port" "$pid"
        elif echo "$line" | grep -q "STOPPED\|EXITED"; then
            printf "%-18s ${YELLOW}%-10s${NC} %-6s %-8s\n" "$svc" "stopped" "$port" "-"
        else
            printf "%-18s ${RED}%-10s${NC} %-6s %-8s\n" "$svc" "unknown" "$port" "-"
        fi
    done
}

do_logs() {
    local target=${1:-supervisord}
    local logfile="$REPO_ROOT/logs/$target.log"
    if [ ! -f "$logfile" ]; then
        echo "Log file not found: $logfile"
        echo "Available: $(ls $REPO_ROOT/logs/*.log 2>/dev/null | xargs -I{} basename {} .log | tr '\n' ' ')"
        return 1
    fi
    tail -f "$logfile"
}

do_build() {
    local target=$1
    case $target in
        openlaputa-panel)
            cd "$REPO_ROOT/panel" && npm run build
            ;;
        "")
            echo "Specify what to build: viewer"
            ;;
        *)
            echo "Unknown target: $target"
            ;;
    esac
}

cmd=$1
shift
target=$1

case $cmd in
    status)  do_status ;;
    start)   ctl start ${target:-all} ;;
    stop)    ctl stop ${target:-all} ;;
    restart) ctl restart ${target:-all} ;;
    logs)    do_logs $target ;;
    reload)  ctl reread && ctl update ;;
    build)   do_build $target ;;
    *)       usage ;;
esac
