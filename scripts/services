#!/bin/bash
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PLIST_DIR="$REPO_ROOT/scripts"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"

SERVICES=(caddy viewer)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

usage() {
    cat <<EOF
Usage: $0 <command> [service]

Commands:
  status              Show status of all services
  start [service]     Start service(s)
  stop [service]      Stop service(s)
  restart [service]   Restart service(s)
  logs [service]      Show logs (tail -f)
  build viewer        Build viewer

Services: ${SERVICES[*]}

Examples:
  $0 status
  $0 start
  $0 restart caddy
  $0 logs viewer
  $0 build viewer
EOF
}

plist_loaded() {
    local svc=$1
    launchctl list | grep -q "com.neuralj.$svc"
}

get_pid() {
    local svc=$1
    launchctl list | grep "com.neuralj.$svc" | awk '{print $1}'
}

get_port() {
    local svc=$1
    case $svc in
        caddy) echo "443" ;;
        viewer) echo "3000" ;;
    esac
}

do_status() {
    printf "%-12s %-10s %-6s %-8s\n" "SERVICE" "STATUS" "PORT" "PID"
    printf "%-12s %-10s %-6s %-8s\n" "-------" "------" "----" "---"
    for svc in "${SERVICES[@]}"; do
        local port=$(get_port $svc)
        if plist_loaded $svc; then
            local pid=$(get_pid $svc)
            if [ "$pid" != "-" ] && [ -n "$pid" ]; then
                printf "%-12s ${GREEN}%-10s${NC} %-6s %-8s\n" "$svc" "running" "$port" "$pid"
            else
                printf "%-12s ${YELLOW}%-10s${NC} %-6s %-8s\n" "$svc" "stopped" "$port" "-"
            fi
        else
            printf "%-12s ${RED}%-10s${NC} %-6s %-8s\n" "$svc" "not loaded" "$port" "-"
        fi
    done
}

load_plist() {
    local svc=$1
    local plist="$PLIST_DIR/com.neuralj.$svc.plist"
    if [ ! -f "$plist" ]; then
        echo "Error: $plist not found"
        return 1
    fi
    mkdir -p "$LAUNCH_AGENTS"
    cp "$plist" "$LAUNCH_AGENTS/"
    launchctl load "$LAUNCH_AGENTS/com.neuralj.$svc.plist"
    echo "$svc started"
}

unload_plist() {
    local svc=$1
    if plist_loaded $svc; then
        launchctl unload "$LAUNCH_AGENTS/com.neuralj.$svc.plist" 2>/dev/null || true
        rm -f "$LAUNCH_AGENTS/com.neuralj.$svc.plist"
        echo "$svc stopped"
    else
        echo "$svc not running"
    fi
}

do_start() {
    local target=$1
    if [ -n "$target" ]; then
        load_plist $target
    else
        for svc in "${SERVICES[@]}"; do
            if ! plist_loaded $svc; then
                load_plist $svc
            else
                echo "$svc already running"
            fi
        done
    fi
}

do_stop() {
    local target=$1
    if [ -n "$target" ]; then
        unload_plist $target
    else
        for svc in "${SERVICES[@]}"; do
            unload_plist $svc
        done
    fi
}

do_restart() {
    local target=$1
    if [ -n "$target" ]; then
        unload_plist $target
        sleep 1
        load_plist $target
    else
        do_stop
        sleep 1
        do_start
    fi
}

do_logs() {
    local target=$1
    case $target in
        caddy)
            tail -f "$REPO_ROOT/caddy/logs/caddy.log"
            ;;
        viewer)
            tail -f "$REPO_ROOT/viewer/logs/viewer.log"
            ;;
        "")
            echo "Specify service: caddy or viewer"
            ;;
        *)
            echo "Unknown service: $target"
            ;;
    esac
}

do_build() {
    local target=$1
    case $target in
        viewer)
            cd "$REPO_ROOT/viewer" && npm run build
            ;;
        "")
            echo "Specify what to build: viewer"
            ;;
        *)
            echo "Unknown target: $target"
            ;;
    esac
}

cmd=$1
shift
target=$1

case $cmd in
    status)  do_status ;;
    start)   do_start $target ;;
    stop)    do_stop $target ;;
    restart) do_restart $target ;;
    logs)    do_logs $target ;;
    build)   do_build $target ;;
    *)       usage ;;
esac
