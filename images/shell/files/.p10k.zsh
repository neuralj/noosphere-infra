# Powerlevel10k 配置
# Generated by Powerlevel10k configuration wizard.

'builtin' 'local' '-a' 'p10k_config_opts'
[[ ! -o 'aliases'         ]] || p10k_config_opts+=('aliases')
[[ ! -o 'sh_glob'         ]] || p10k_config_opts+=('sh_glob')
[[ ! -o 'no_aliases'      ]] || p10k_config_opts+=('no_aliases')
[[ ! -o 'no_brace_expand' ]] || p10k_config_opts+=('no_brace_expand')
'builtin' 'setopt' 'no_aliases' 'no_sh_glob' 'brace_expand'

() {
  emulate -L zsh -o extended_glob

  unset -m '(POWERLEVEL9K_*|DEFAULT_USER)~POWERLEVEL9K_GITSTATUS_DIR'

  autoload -Uz is-at-least && is-at-least 5.1 || return

  # Prompt style: lean-8colors
  POWERLEVEL9K_MODE=nerdfont-v3
  POWERLEVEL9K_ICON_PADDING=moderate

  # Left prompt segments
  POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(
    os_icon
    dir
    vcs
    prompt_char
  )

  # Right prompt segments
  POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(
    status
    command_execution_time
    background_jobs
    ram
    load
    cpu_arch
    time
  )

  # Basic style options
  POWERLEVEL9K_BACKGROUND=                            # transparent background
  POWERLEVEL9K_{LEFT,RIGHT}_{LEFT,RIGHT}_WHITESPACE=  # no surrounding whitespace
  POWERLEVEL9K_{LEFT,RIGHT}_SUBSEGMENT_SEPARATOR=' '  # separate segments with a space
  POWERLEVEL9K_{LEFT,RIGHT}_SEGMENT_SEPARATOR=        # no end-of-line symbol
  POWERLEVEL9K_VISUAL_IDENTIFIER_EXPANSION=           # no segment icons

  POWERLEVEL9K_PROMPT_ADD_NEWLINE=true                # add newline before prompt

  POWERLEVEL9K_PROMPT_ON_NEWLINE=false
  POWERLEVEL9K_RPROMPT_ON_NEWLINE=false

  POWERLEVEL9K_{LEFT,RIGHT}_PROMPT_LAST_SEGMENT_END_SYMBOL=' '
  POWERLEVEL9K_{LEFT,RIGHT}_PROMPT_FIRST_SEGMENT_START_SYMBOL=

  # OS icon
  POWERLEVEL9K_OS_ICON_FOREGROUND=7

  # Dir
  POWERLEVEL9K_SHORTEN_STRATEGY=truncate_to_last
  POWERLEVEL9K_SHORTEN_DIR_LENGTH=3
  POWERLEVEL9K_DIR_FOREGROUND=4

  # VCS
  POWERLEVEL9K_VCS_BRANCH_ICON='\uF126 '
  POWERLEVEL9K_VCS_COMMIT_HASH_LENGTH=8
  POWERLEVEL9K_VCS_CLEAN_FOREGROUND=2
  POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=3
  POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=5
  POWERLEVEL9K_VCS_CONFLICTED_FOREGROUND=1
  POWERLEVEL9K_VCS_LOADING_FOREGROUND=8

  # Prompt char
  POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=2
  POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=1
  POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIINS_CONTENT_EXPANSION='❯'
  POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VICMD_CONTENT_EXPANSION='❮'
  POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIVIS_CONTENT_EXPANSION='V'
  POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIOWR_CONTENT_EXPANSION='▶'
  POWERLEVEL9K_PROMPT_CHAR_OVERWRITE_STATE=true
  POWERLEVEL9K_PROMPT_CHAR_LEFT_PROMPT_LAST_SEGMENT_END_SYMBOL=''
  POWERLEVEL9K_PROMPT_CHAR_LEFT_PROMPT_FIRST_SEGMENT_START_SYMBOL=

  # Status
  POWERLEVEL9K_STATUS_EXTENDED_STATES=true
  POWERLEVEL9K_STATUS_OK=false
  POWERLEVEL9K_STATUS_OK_FOREGROUND=2
  POWERLEVEL9K_STATUS_OK_VISUAL_IDENTIFIER_EXPANSION='✔'
  POWERLEVEL9K_STATUS_OK_PIPE=true
  POWERLEVEL9K_STATUS_OK_PIPE_FOREGROUND=2
  POWERLEVEL9K_STATUS_OK_PIPE_VISUAL_IDENTIFIER_EXPANSION='✔'
  POWERLEVEL9K_STATUS_ERROR=true
  POWERLEVEL9K_STATUS_ERROR_FOREGROUND=1
  POWERLEVEL9K_STATUS_ERROR_VISUAL_IDENTIFIER_EXPANSION='✘'
  POWERLEVEL9K_STATUS_ERROR_SIGNAL=true
  POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND=1
  POWERLEVEL9K_STATUS_VERBOSE_SIGNAME=false
  POWERLEVEL9K_STATUS_ERROR_SIGNAL_VISUAL_IDENTIFIER_EXPANSION='✘'
  POWERLEVEL9K_STATUS_ERROR_PIPE=true
  POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND=1
  POWERLEVEL9K_STATUS_ERROR_PIPE_VISUAL_IDENTIFIER_EXPANSION='✘'

  # Command execution time
  POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD=3
  POWERLEVEL9K_COMMAND_EXECUTION_TIME_PRECISION=0
  POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND=7
  POWERLEVEL9K_COMMAND_EXECUTION_TIME_FORMAT='d h m s'
  POWERLEVEL9K_COMMAND_EXECUTION_TIME_PREFIX='took '
  POWERLEVEL9K_COMMAND_EXECUTION_TIME_PREFIX_FOREGROUND=7

  # Background jobs
  POWERLEVEL9K_BACKGROUND_JOBS_VERBOSE=false
  POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND=6

  # RAM
  POWERLEVEL9K_RAM_FOREGROUND=2

  # Load
  POWERLEVEL9K_LOAD_WHICH=5
  POWERLEVEL9K_LOAD_FOREGROUND=3

  # CPU arch
  POWERLEVEL9K_CPU_ARCH_FOREGROUND=7

  # Time
  POWERLEVEL9K_TIME_FORMAT='%D{%H:%M}'
  POWERLEVEL9K_TIME_UPDATE_ON_COMMAND=false
  POWERLEVEL9K_TIME_FOREGROUND=6

  # Transient prompt
  POWERLEVEL9K_TRANSIENT_PROMPT=off

  # Instant prompt
  POWERLEVEL9K_INSTANT_PROMPT=verbose

  # Hot reload
  POWERLEVEL9K_DISABLE_HOT_RELOAD=true

  (( ${#p10k_config_opts} )) && setopt ${p10k_config_opts[@]}
  'builtin' 'unset' 'p10k_config_opts'
}
